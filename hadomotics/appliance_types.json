      "unknown": "Ninguno"
    },
    "vacuum_state": {
      "docked": "En la base", "cleaning": "Limpiando", "returning": "Volviendo a la base", "paused": "En pausa",
      "idle": "Parada", "error": "Error"
    },
    "vacuum_detail": {
      "charging": "Cargando", "charging_complete": "Carga completa", "cleaning": "Limpiando", "segment_cleaning": "Limpiando habitaciones",
      "zoned_cleaning": "Limpiando zona", "spot_cleaning": "Limpieza puntual", "returning_home": "Volviendo a la base", "docking": "Entrando en la base",
      "paused": "En pausa", "idle": "Parada", "washing_the_mop": "Lavando la mopa", "going_to_wash_the_mop": "Va a lavar la mopa",
      "emptying_the_bin": "Vaciando el depósito", "air_drying_stopping": "Terminando el secado", "mapping": "Creando mapa", "error": "Error",
      "device_offline": "Sin conexión", "charger_disconnected": "Base desconectada", "charging_problem": "Problema de carga"
