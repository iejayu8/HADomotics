    "vacuum_clean_mode": { "vacuum": "Aspirar", "vac_and_mop": "Aspirar y fregar", "mop": "Fregar" },
    "vacuum_fan": {
      "quiet": "Silencioso", "balanced": "Equilibrado", "turbo": "Turbo", "max": "Máximo", "max_plus": "Máximo+",
      "off": "Sin aspirar", "smart_mode": "Inteligente", "custom": "Personalizado"
    }
  }
}
