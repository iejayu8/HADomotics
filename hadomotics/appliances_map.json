        { "entity": "vacuum.qrevo_edge_2_pro", "attribute": "fan_speed", "label": "Potencia de aspiración", "labels": "vacuum_fan" },
        { "entity": "sensor.qrevo_edge_2_pro_habitacion_actual", "label": "Habitación actual" },
        { "entity": "sensor.qrevo_edge_2_pro_progreso_de_la_limpieza", "label": "Progreso", "format": "value" },
        { "entity": "sensor.qrevo_edge_2_pro_error_de_aspirador", "label": "Error", "labels": { "none": "Ninguno" }, "alert_not": ["none", "unknown", "unavailable"] },
        { "entity": "sensor.qrevo_edge_2_pro_dock_error_en_la_base", "label": "Base", "labels": { "ok": "Sin errores" }, "alert_not": ["ok", "unknown", "unavailable"] }
