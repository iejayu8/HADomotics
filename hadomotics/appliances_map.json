        { "entity": "binary_sensor.cocina_nevera_puerta_del_congelador", "label": "Puerta del congelador", "labels": { "on": "Abierta", "off": "Cerrada" }, "alert": ["on"] },
        { "entity": "sensor.cocina_nevera_potencia", "label": "Potencia", "format": "value" }
