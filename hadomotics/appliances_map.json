    {
      "id": "lavavajillas",
      "kind": "dishwasher",
      "name": "Lavavajillas",
      "model": "Bosch SMV2ITX09E",
      "floor": "planta_baja",
      "position": [0.245, 0.15],
      "location": {
        "area": "cocina",
        "source": "area_ha",
        "note": "Área de Home Assistant: Cocina. Punto exacto supuesto: bajo la encimera superior, junto al fregadero."
      },
      "main": "sensor.cocina_lavavajillas_estado_de_operacion",
      "running": { "entity": "sensor.cocina_lavavajillas_estado_de_operacion", "when": ["run", "delayedstart", "pause"] },
      "badge": [
        { "entity": "sensor.cocina_lavavajillas_estado_de_operacion", "labels": "dishwasher_state" },
        { "entity": "sensor.cocina_lavavajillas_hora_de_finalizacion_del_programa", "format": "remaining" }
      ],
      "alerts": [
        { "entity": "sensor.cocina_lavavajillas_estado_de_operacion", "when": ["error", "actionrequired"], "text": "El lavavajillas necesita atención" }
      ],
      "status": [
        { "entity": "sensor.cocina_lavavajillas_estado_de_operacion", "label": "Estado", "labels": "dishwasher_state", "alert": ["error", "actionrequired"] },
        { "entity": "select.cocina_lavavajillas_programa_activo", "label": "Programa en curso", "labels": "dishwasher_program" },
        { "entity": "sensor.cocina_lavavajillas_progreso_del_programa", "label": "Progreso", "format": "value" },
        { "entity": "sensor.cocina_lavavajillas_hora_de_finalizacion_del_programa", "label": "Tiempo restante", "format": "remaining" },
        { "entity": "sensor.cocina_lavavajillas_puerta", "label": "Puerta", "labels": { "closed": "Cerrada", "locked": "Bloqueada", "open": "Abierta" } },
        { "entity": "binary_sensor.cocina_lavavajillas_inicio_remoto", "label": "Inicio remoto", "labels": { "on": "Permitido", "off": "No permitido (actívalo en el aparato)" } }
      ],
      "controls": [
        { "type": "switch", "entity": "switch.cocina_lavavajillas_energia", "label": "Encendido" },
        { "type": "select", "entity": "select.cocina_lavavajillas_programa_seleccionado", "label": "Programa", "labels": "dishwasher_program" },
        { "type": "switch", "entity": "switch.cocina_lavavajillas_media_carga", "label": "Media carga" },
        { "type": "switch", "entity": "switch.cocina_lavavajillas_extra_seco", "label": "Extra seco" },
        { "type": "switch", "entity": "switch.cocina_lavavajillas_higiene", "label": "Higiene +" }
      ],
      "actions": [
        {
          "id": "start",
          "label": "Iniciar",
          "icon": "play_arrow",
          "domain": "select",
          "service": "select_option",
          "entity": "select.cocina_lavavajillas_programa_activo",
          "option_from": "select.cocina_lavavajillas_programa_seleccionado",
          "option_labels": "dishwasher_program",
          "enabled_when": [
            { "entity": "sensor.cocina_lavavajillas_estado_de_operacion", "in": ["ready", "inactive"] },
            { "entity": "binary_sensor.cocina_lavavajillas_inicio_remoto", "in": ["on"] }
          ],
          "confirm": "¿Iniciar el programa «{option}» en el lavavajillas?"
        },
        {
          "id": "stop",
          "label": "Detener",
          "icon": "stop",
          "domain": "button",
          "service": "press",
          "entity": "button.cocina_lavavajillas_detener_programa",
          "enabled_when": [
            { "entity": "sensor.cocina_lavavajillas_estado_de_operacion", "in": ["run", "pause", "delayedstart", "actionrequired"] }
          ],
          "confirm": "¿Detener el programa del lavavajillas?"
        }
      ],
      "notes": ["Home Assistant no expone «pausar» para este lavavajillas: solo iniciar el programa seleccionado y detenerlo."]
    },
    {
