        { "id": "home", "label": "Volver a la base", "icon": "home", "domain": "vacuum", "service": "return_to_base", "entity": "vacuum.qrevo_edge_2_pro",
          "enabled_when": [{ "entity": "vacuum.qrevo_edge_2_pro", "in": ["cleaning", "paused", "idle", "error", "returning"] }] },
        { "id": "locate", "label": "Localizar", "icon": "volume_up", "domain": "vacuum", "service": "locate", "entity": "vacuum.qrevo_edge_2_pro" }
